---
// Dates and guests form that hands off to /book/ with a plain GET. Works without JavaScript.
interface Props {
  slug: string;
  maxGuests: number;
  tone?: 'light' | 'dark';
  id?: string;
}
const { slug, maxGuests, tone = 'light', id = 'bar' } = Astro.props;
const guests = Array.from({ length: maxGuests }, (_, i) => i + 1);
---
<form class:list={['booking-bar', tone]} action="/book/" method="get" aria-label="Check dates">
  <input type="hidden" name="stay" value={slug} />
  <div class="cell">
    <label class="label" for={`${id}-in`}>Check in</label>
    <input id={`${id}-in`} name="checkin" type="date" required />
  </div>
  <div class="cell">
    <label class="label" for={`${id}-out`}>Check out</label>
    <input id={`${id}-out`} name="checkout" type="date" required />
  </div>
  <div class="cell">
    <label class="label" for={`${id}-guests`}>Guests</label>
    <select id={`${id}-guests`} name="guests">
      {guests.map((g) => <option value={g} selected={g === 2}>{g} {g === 1 ? 'guest' : 'guests'}</option>)}
    </select>
  </div>
  <button class:list={['btn', tone === 'dark' ? 'btn-on-dark' : 'btn-primary']} type="submit" data-event="booking_started">Check dates</button>
</form>

<style>
  .booking-bar { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--color-line-strong); border-radius: var(--radius-sm); }
  .cell { display: flex; flex-direction: column; gap: 2px; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-line-strong); min-width: 0; }
  .cell:first-of-type { border-right: 1px solid var(--color-line-strong); }
  .cell:nth-of-type(3) { grid-column: 1 / 3; }
  .label { font-size: 11px; letter-spacing: var(--type-label-tracking); }
  .dark .label { color: var(--color-muted-dark); }
  input, select {
    font: inherit; font-size: 16px; color: inherit; background: transparent; border: 0; padding: 0; min-height: 32px; width: 100%;
    color-scheme: light;
  }
  .dark input, .dark select { color-scheme: dark; }
  select option { color: var(--color-charcoal); }
  .btn { grid-column: 1 / 3; border-radius: 0; min-height: var(--control-height); }
  @media (min-width: 768px) {
    .booking-bar { grid-template-columns: 1fr 1fr 0.8fr auto; }
    .cell { border-bottom: 0; border-right: 1px solid var(--color-line-strong); }
    .cell:nth-of-type(3) { grid-column: auto; }
    .btn { grid-column: auto; padding: 0 var(--space-5); }
  }
</style>
