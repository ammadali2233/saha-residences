---
import Icon from './Icon.astro';
import type { Listing } from '../content/listings';
import Placeholdered from './Placeholdered.astro';

interface Props {
  amenities: Listing['amenities'];
}
const { amenities } = Astro.props;
---
<ul class="amenities">
  {amenities.map((a) => (
    <li>
      <Icon name={a.icon} size={24} />
      <div>
        <h3 class="name">{a.name}</h3>
        <p class="detail"><Placeholdered text={a.detail} /></p>
      </div>
    </li>
  ))}
</ul>

<style>
  .amenities { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0 var(--space-6); border-top: 1px solid var(--color-line); }
  li { display: flex; gap: var(--space-4); align-items: flex-start; padding: var(--space-5) 0; border-bottom: 1px solid var(--color-line); }
  li :global(svg) { flex: none; }
  .name { font-family: var(--font-sans); font-size: 16px; line-height: 24px; font-weight: 500; }
  .detail { font-size: 14px; line-height: 1.5; color: var(--color-muted); margin-top: var(--space-1); }
</style>
