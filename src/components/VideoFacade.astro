---
// Click-to-load YouTube tour (D-018): only a poster until the guest asks, so no third-party code on page load.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  videoId: string | null;
  poster: ImageMetadata;
  title: string;
}
const { videoId, poster, title } = Astro.props;
---
{videoId ? (
  <div class="video" data-video-id={videoId} data-title={title}>
    <Image src={poster} alt="" widths={[600, 900]} sizes="(max-width: 767px) 100vw, 720px" class="poster" />
    <button type="button" class="play"><Icon name="play" size={22} /> Play the video tour</button>
  </div>
) : (
  <p class="card"><mark class="placeholder">[PLACEHOLDER: walkthrough video. Upload it to YouTube and add the video ID in src/content/listings.ts]</mark></p>
)}

<script>
  // Swaps the poster for a privacy-enhanced YouTube player only after a click.
  for (const el of document.querySelectorAll<HTMLElement>('.video[data-video-id]')) {
    el.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.videoId}?autoplay=1&rel=0`;
      frame.title = el.dataset.title ?? 'Video tour';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      el.replaceChildren(frame);
      frame.focus();
    }, { once: true });
  }
</script>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-md); overflow: hidden; background: var(--color-charcoal); }
  .poster, .video :global(iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  .play { position: absolute; inset: auto auto var(--space-4) var(--space-4); display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-height); padding: 0 var(--space-5); background: var(--color-charcoal); color: var(--color-stone); border: 0; border-radius: var(--radius-sm); font: inherit; font-weight: 500; cursor: pointer; }
</style>
