---
// Home spine (redesign, concept B): the page moves through a day at the house. The hero knows the time in Lahore
// (set before first paint, so nothing shifts); chapters change colour temperature, and a small sun arc on each one
// tells the power story honestly: solar charges the backup by day, the backup covers load shedding at night.
import { Image, Picture } from 'astro:assets';
import { DHA_RETREAT as L } from '../../content/listings';
const [master, lounge, , third] = L.photos;
---
  <script is:inline>
    // Sets the part of day in Lahore before first paint, so the hero never flashes or shifts (no layout change).
    (function () {
      var h = +new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Asia/Karachi' }).format(new Date());
      document.documentElement.dataset.daypart = h < 5 ? 'night' : h < 11 ? 'morning' : h < 17 ? 'afternoon' : h < 20 ? 'evening' : 'night';
    })();
  </script>

  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="greeting" aria-live="off">
        <span class="g-default">Morning light, quiet afternoons, evenings in.</span>
        <span class="g-morning">Good morning from Lahore.</span>
        <span class="g-afternoon">Good afternoon from Lahore.</span>
        <span class="g-evening">Good evening from Lahore.</span>
        <span class="g-night">It's night in Lahore. The lights are still on.</span>
      </p>
      <h1 id="home-title">A day at DHA Retreat.</h1>
      <p class="sub">A three-bedroom house in DHA Phase 9 Town, with solar power, a caretaker on site and room for up to eight.</p>
    </div>
    <svg class="hero-sun" viewBox="0 0 360 200" aria-hidden="true">
      <path class="arc" d="M20 180 A160 160 0 0 1 340 180" />
      <line class="horizon" x1="0" y1="180" x2="360" y2="180" />
      <g class="sun-g"><circle class="sun" cx="20" cy="180" r="9" /></g>
    </svg>
    <Picture class="hero-photo" src={master.src} alt={master.alt} formats={['avif', 'webp']} widths={[400, 600, 800, 1086]} sizes="(max-width: 767px) 100vw, 46vw" loading="eager" fetchpriority="high" />
  </section>

  <div class="day">
    <ol class="chapters">
      <li class="ch morning">
        <div class="ch-text reveal-rise draw-on-scroll">
          <p class="time"><svg class="mini" viewBox="0 0 120 64" aria-hidden="true"><path class="arc draw-line" pathLength="1" d="M6 58 A54 54 0 0 1 114 58" /><line class="horizon" x1="0" y1="58" x2="120" y2="58" /><g class="mini-sun" style="--deg:15deg"><circle class="sun" cx="6" cy="58" r="5" /></g></svg>7:00 am · <span>Solar charging the backup</span></p>
          <h2>Wake up slowly.</h2>
          <p>Sheers soften the light in the master bedroom. Velvet curtains draw closed when you want to sleep in.</p>
        </div>
      </li>
      <li class="ch afternoon">
        <div class="ch-text reveal-rise draw-on-scroll">
          <p class="time"><svg class="mini" viewBox="0 0 120 64" aria-hidden="true"><path class="arc draw-line" pathLength="1" d="M6 58 A54 54 0 0 1 114 58" /><line class="horizon" x1="0" y1="58" x2="120" y2="58" /><g class="mini-sun" style="--deg:105deg"><circle class="sun" cx="6" cy="58" r="5" /></g></svg>1:00 pm · <span>Solar charging the backup</span></p>
          <h2>Work upstairs.</h2>
          <p>A study table in the games room, between the two upstairs bedrooms. When the grid goes, solar and the UPS keep the Wi-Fi up.</p>
        </div>
        <div class="ch-img placeholder-photo reveal-wipe"><span>Photo coming: the study table</span></div>
      </li>
      <li class="ch evening">
        <div class="ch-text reveal-rise draw-on-scroll">
          <p class="time"><svg class="mini" viewBox="0 0 120 64" aria-hidden="true"><path class="arc draw-line" pathLength="1" d="M6 58 A54 54 0 0 1 114 58" /><line class="horizon" x1="0" y1="58" x2="120" y2="58" /><g class="mini-sun" style="--deg:200deg"><circle class="sun" cx="6" cy="58" r="5" /></g></svg>7:30 pm · <span>Backup charged</span></p>
          <h2>Games night.</h2>
          <p>The games room upstairs, or the curved sofa in the lounge downstairs. Room for the whole family.</p>
        </div>
        <div class="ch-img reveal-wipe"><Image src={lounge.src} alt={lounge.alt} widths={[500, 800]} sizes="(max-width: 767px) 100vw, 45vw" class="settle" /></div>
      </li>
      <li class="ch night">
        <div class="ch-text reveal-rise draw-on-scroll">
          <p class="time"><svg class="mini" viewBox="0 0 120 64" aria-hidden="true"><path class="arc draw-line" pathLength="1" d="M6 58 A54 54 0 0 1 114 58" /><line class="horizon" x1="0" y1="58" x2="120" y2="58" /><g class="mini-sun" style="--deg:250deg"><circle class="sun" cx="6" cy="58" r="5" /></g></svg>11:00 pm · <span>Backup ready for load shedding</span></p>
          <h2>The lights stay on.</h2>
          <p>Load shedding at night? The UPS takes over: lights, fans and Wi-Fi keep running. <mark class="placeholder">[PLACEHOLDER: does the backup run air conditioning?]</mark></p>
        </div>
        <div class="ch-img reveal-wipe"><Image src={third.src} alt={third.alt} widths={[500, 800]} sizes="(max-width: 767px) 100vw, 45vw" class="settle" /></div>
      </li>
    </ol>
  </div>

<style>
  /* ---------------- hero: tinted by the time in Lahore (set before paint) ---------------- */
  .hero { --bg: var(--color-stone); --fg: var(--color-charcoal); --muted: var(--color-muted); background: var(--bg); color: var(--fg); display: grid; padding: var(--space-6) var(--gutter) 0; gap: var(--space-5); }
  :global(html[data-daypart='morning']) .hero { --bg: var(--color-stone-50); }
  :global(html[data-daypart='evening']) .hero, :global(html[data-daypart='night']) .hero { --bg: var(--color-charcoal); --fg: var(--color-stone); --muted: var(--color-muted-dark); }
  .hero h1 { color: var(--fg); font-size: clamp(48px, 10vw, 120px); line-height: 0.95; letter-spacing: -0.02em; }
  .greeting { font-size: var(--type-label-size); letter-spacing: var(--type-label-tracking); text-transform: uppercase; font-weight: 500; color: var(--muted); margin-bottom: var(--space-4); }
  .greeting span { display: none; }
  .g-default { display: inline !important; }
  :global(html[data-daypart]) .g-default { display: none !important; }
  :global(html[data-daypart='morning']) .g-morning, :global(html[data-daypart='afternoon']) .g-afternoon,
  :global(html[data-daypart='evening']) .g-evening, :global(html[data-daypart='night']) .g-night { display: inline; }
  .sub { color: var(--muted); font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line); max-width: 40ch; margin-top: var(--space-4); }
  .hero-sun { width: 160px; height: auto; justify-self: end; }
  .arc { fill: none; stroke: currentColor; stroke-width: 1; stroke-dasharray: 3 5; opacity: 0.6; }
  .horizon { stroke: currentColor; stroke-width: 1; }
  .sun { fill: var(--color-walnut); }
  :global(html[data-daypart='evening']) .hero .sun, :global(html[data-daypart='night']) .hero .sun { fill: var(--color-stone); }
  .sun-g { transform-box: view-box; transform-origin: 180px 180px; transform: rotate(90deg); }
  :global(html[data-daypart='morning']) .sun-g { transform: rotate(40deg); }
  :global(html[data-daypart='evening']) .sun-g { transform: rotate(160deg); }
  :global(html[data-daypart='night']) .sun-g { transform: rotate(200deg); }
  .hero :global(.hero-photo) { width: calc(100% + 2 * var(--gutter)); margin: 0 calc(-1 * var(--gutter)); height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  @media (min-width: 768px) {
    .hero { grid-template-columns: 6fr 5fr; grid-template-rows: auto 1fr; padding: var(--space-8) var(--gutter) 0; column-gap: var(--space-7); }
    .hero-copy { grid-column: 1; grid-row: 1 / 3; align-self: center; padding-bottom: var(--space-9); }
    .hero-sun { grid-column: 2; grid-row: 1; width: 220px; }
    /* Photo drops below the band into the next section: deliberate overlap. */
    .hero :global(.hero-photo) { grid-column: 2; grid-row: 2; width: 100%; margin: 0 0 calc(-1 * var(--space-9)); position: relative; z-index: 2; }
  }

  /* ---------------- the day: chapters with a travelling sun ---------------- */
  .chapters { list-style: none; margin: 0; padding: 0; }

  .ch { display: grid; gap: var(--space-6); padding: var(--space-9) var(--gutter); }
  .ch.morning { background: var(--color-stone-50); }
  .ch.afternoon { background: var(--color-stone); }
  .ch.evening, .ch.night { background: var(--color-charcoal); color: var(--color-stone); }
  .ch.evening h2, .ch.night h2 { color: var(--color-stone); }
  .ch.evening .ch-text > p:not(.time), .ch.night .ch-text > p:not(.time) { color: var(--color-muted-dark); }
  .ch h2 { font-size: clamp(40px, 7vw, 88px); line-height: 1; letter-spacing: -0.015em; margin: var(--space-2) 0 var(--space-4); }
  .ch-text > p:not(.time) { color: var(--color-muted); max-width: 42ch; font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line); }
  .mini { width: 72px; height: auto; display: block; margin-bottom: var(--space-2); overflow: visible; }
  .mini .arc { stroke-dasharray: 1; }
  .mini-sun { transform-box: view-box; transform-origin: 60px 58px; transform: rotate(var(--deg)); }
  .night .sun, .evening .sun { fill: var(--color-stone); }
  .time span { color: var(--color-olive); }
  .evening .time span, .night .time span { color: var(--color-muted-dark); }
  .time { font-size: var(--type-label-size); letter-spacing: var(--type-label-tracking); text-transform: uppercase; font-weight: 500; }
  .ch-img :global(img), .placeholder-photo { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .ch-img { overflow: hidden; }
  .placeholder-photo { display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-line-strong); color: var(--color-muted); font-size: 14px; background: transparent; }
  @media (min-width: 768px) {
    .ch { grid-template-columns: repeat(12, 1fr); align-items: end; min-height: 80vh; }
    .ch.morning { min-height: 0; padding-top: var(--space-7); }
    .morning .ch-text { grid-column: 1 / 6; }
    .afternoon .ch-text { grid-column: 8 / 13; grid-row: 1; } .afternoon .ch-img { grid-column: 2 / 7; grid-row: 1; aspect-ratio: auto; }
    .afternoon .placeholder-photo { aspect-ratio: 3 / 2; }
    .evening .ch-text { grid-column: 1 / 5; align-self: start; } .evening .ch-img { grid-column: 5 / 13; } .evening .ch-img :global(img) { aspect-ratio: 16 / 10; }
    .night .ch-text { grid-column: 7 / 12; } .night .ch-img { grid-column: 2 / 6; grid-row: 1; } .night .ch-img :global(img) { aspect-ratio: 3 / 4; }
  }

</style>
