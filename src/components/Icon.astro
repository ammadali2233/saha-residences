---
// Lucide line icon: 2px stroke, round caps, no fill (brand guide). Decorative unless `label` is set.
import { iconBody, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconBody(name)}
/>
