---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: 13px; color: var(--color-muted); }
  li + li::before { content: '/'; margin-right: var(--space-2); }
  a { min-height: 24px; display: inline-block; }
</style>
