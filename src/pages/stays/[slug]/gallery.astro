---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { LISTINGS, type Listing } from '../../../content/listings';
import { breadcrumbLd } from '../../../lib/seo';

export function getStaticPaths() {
  return LISTINGS.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

const { listing: L } = Astro.props as { listing: Listing };
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const stayUrl = `/stays/${L.slug}/`;
// Full-size versions for the lightbox; the grid links to them so it works without JavaScript.
const large = await Promise.all(L.photos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp' })));
---
<BaseLayout
  title={`Photos of ${L.name}, DHA Phase 9, Lahore`}
  description={`Photos of ${L.name}: the master bedroom with a king bed, the queen and twin bedrooms, and the lounge. Real photos of the house as guests find it.`}
  shareImage={L.photos[0].src}
  shareAlt={L.photos[0].alt}
  jsonLd={[breadcrumbLd([
    { name: 'Stays', url: new URL('/stays/', Astro.site) },
    { name: L.name, url: new URL(stayUrl, Astro.site) },
    { name: 'Photos', url: pageUrl },
  ])]}
>
  <div class="container-wide page-head gallery-head">
    <Breadcrumbs items={[{ name: 'Stays', href: '/stays/' }, { name: L.name, href: stayUrl }, { name: 'Photos', href: pageUrl.pathname }]} />
    <h1>Photos of {L.name}</h1>
    <p class="lede">Every photo is of the house as you'll find it. Select a photo to see it larger, then use the arrow keys to move between them.</p>
  </div>

  <div class="container-wide section">
    <ul class="grid" data-gallery>
      {L.photos.map((p, i) => (
        <li class={`g${i % 4}`}>
          <a class:list={[{ "reveal-wipe": i > 1 }]} href={large[i].src} data-full={large[i].src} data-index={i}>
            <Image src={p.src} alt={p.alt} widths={[360, 540, 720, 900]} quality={75} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 640px" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          </a>
          <p class="caption">{p.caption}</p>
        </li>
      ))}
    </ul>

    <div class="missing card stack-2">
      <h2>More photos coming</h2>
      <p class="muted">We're photographing the rest of the house: <mark class="placeholder">[PLACEHOLDER: {L.missingPhotos.join(', ')}]</mark></p>
    </div>
    <p class="back"><a class="text-link" href={stayUrl}>Back to {L.name}</a></p>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" />
      <figcaption></figcaption>
    </figure>
    <div class="controls">
      <button type="button" data-prev aria-label="Previous photo">‹</button>
      <span data-count aria-live="polite"></span>
      <button type="button" data-next aria-label="Next photo">›</button>
      <button type="button" data-close aria-label="Close photo viewer">Close</button>
    </div>
  </dialog>
<script>
  // Keyboard-friendly lightbox on the native <dialog>: Esc closes, arrows move, focus returns to the photo you opened.
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (grid && dialog) {
    const links = [...grid.querySelectorAll<HTMLAnchorElement>('a[data-full]')];
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('[data-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      const thumb = link.querySelector('img')!;
      img.src = link.dataset.full!;
      img.alt = thumb.alt;
      caption.textContent = link.parentElement?.querySelector('.caption')?.textContent ?? '';
      count.textContent = `Photo ${index + 1} of ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

</BaseLayout>

<style>
  /* Editorial sequence: sizes, crops and offsets change from photo to photo (redesign audit). Square edges. */
  .gallery-head h1 { font-size: clamp(48px, 9vw, 112px); line-height: 0.96; letter-spacing: -0.02em; max-width: 12ch; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-7) var(--space-5); }
  .grid a { display: block; overflow: hidden; }
  .grid :global(img) { width: 100%; height: auto; object-fit: cover; display: block; }
  .grid .caption { margin-top: var(--space-2); }
  .g0 :global(img) { aspect-ratio: 4 / 5; } .g1 :global(img) { aspect-ratio: 16 / 10; } .g2 :global(img) { aspect-ratio: 1; } .g3 :global(img) { aspect-ratio: 3 / 4; }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(12, 1fr); align-items: start; }
    .g0 { grid-column: 1 / 7; } .g1 { grid-column: 8 / 13; margin-top: var(--space-9); }
    .g2 { grid-column: 3 / 7; } .g3 { grid-column: 8 / 12; margin-top: calc(-1 * var(--space-8)); }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .grid a :global(img) { transition: transform var(--motion-reveal) var(--ease-settle); }
    .grid a:hover :global(img), .grid a:focus-visible :global(img) { transform: scale(1.03); }
  }
  .missing { margin-top: var(--space-7); }
  .missing h2 { font-size: var(--type-h4-size); line-height: var(--type-h4-line); }
  .back { margin-top: var(--space-5); }

  @media (prefers-reduced-motion: no-preference) { .lightbox[open] figure img { animation: motion-fade var(--motion-state) var(--ease-settle); } .lightbox[open]::backdrop { animation: motion-fade var(--motion-state) var(--ease-settle); } }
  .lightbox { border: 0; padding: 0; background: var(--color-charcoal); color: var(--color-stone); max-width: 100vw; max-height: 100vh; width: 100vw; height: 100dvh; }
  .lightbox::backdrop { background: rgb(38 37 35 / 0.9); }
  .lightbox[open] { display: grid; grid-template-rows: 1fr auto; }
  figure { margin: 0; display: grid; grid-template-rows: 1fr auto; min-height: 0; padding: var(--space-4); gap: var(--space-3); }
  figure img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  figcaption { text-align: center; font-size: 14px; color: var(--color-muted-dark); }
  .controls { display: flex; justify-content: center; align-items: center; gap: var(--space-3); padding: 0 var(--space-4) var(--space-5); }
  .controls button { min-width: var(--control-height); min-height: var(--control-height); background: transparent; color: var(--color-stone); border: 1px solid var(--color-stone); border-radius: var(--radius-sm); font: inherit; font-size: 20px; cursor: pointer; padding: 0 var(--space-4); }
  .controls [data-close] { font-size: 15px; }
  .controls :focus-visible { outline-color: var(--color-stone); }
  [data-count] { font-size: 14px; color: var(--color-muted-dark); min-width: 9ch; text-align: center; }
</style>
