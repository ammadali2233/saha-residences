---
// Listing page (redesign: concept A's floor plan at its centre). Editorial opening, the house in two floors,
// the particulars, rules and the way there. Booking lives in the sticky bar.
import { Image, Picture, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FloorPlan from '../../../components/FloorPlan.astro';
import Particulars from '../../../components/Particulars.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import Placeholdered from '../../../components/Placeholdered.astro';
import Icon from '../../../components/Icon.astro';
import { LISTINGS, type Listing } from '../../../content/listings';
import { breadcrumbLd, vacationRentalLd } from '../../../lib/seo';

export function getStaticPaths() {
  return LISTINGS.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

const { listing: L } = Astro.props as { listing: Listing };
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const images = await Promise.all(L.photos.map((p) => getImage({ src: p.src, width: 1200, format: 'jpg' })));
const jsonLd = [
  vacationRentalLd(L, pageUrl, images.map((i) => new URL(i.src, Astro.site).href)),
  breadcrumbLd([
    { name: 'Stays', url: new URL('/stays/', Astro.site) },
    { name: L.name, url: pageUrl },
  ]),
];
const [master, , , third] = L.photos;
---
<BaseLayout
  title={`${L.name}: 3-bedroom house in DHA Phase 9, Lahore`}
  description={`${L.name} sleeps 6 in beds and up to 8 with extra bedding, across two floors, with solar and UPS backup, a games room, a workspace and a caretaker on site. From ${L.priceFrom.amount} a night.`}
  shareImage={master.src}
  shareAlt={master.alt}
  jsonLd={jsonLd}
>
  <section class="open" aria-labelledby="stay-title">
    <div class="open-copy">
      <Breadcrumbs items={[{ name: 'Stays', href: '/stays/' }, { name: L.name, href: pageUrl.pathname }]} />
      <h1 id="stay-title">{L.name}</h1>
      <p class="lede">A two-storey house in {L.area}. Three bedrooms, four bathrooms, a games room upstairs and power that stays on. Sleeps {L.facts.sleeps}, up to {L.facts.maxGuests}.</p>
      <p class="price"><span>{L.priceFrom.amount}</span> a night for up to 6 guests</p>
    </div>
    <div class="open-photos">
      <Picture class="ph-main" src={master.src} alt={master.alt} formats={['avif', 'webp']} widths={[400, 600, 800, 1086]} sizes="(max-width: 767px) 100vw, 44vw" loading="eager" fetchpriority="high" pictureAttributes={{ class: "ph-main-pic" }} />
      <Image class="ph-side reveal-wipe" src={third.src} alt={third.alt} widths={[300, 500]} sizes="(max-width: 767px) 50vw, 20vw" />
      <a class="all link-draw" href={`/stays/${L.slug}/gallery/`}><Icon name="image" size={18} /> All photos</a>
    </div>
  </section>

  <section id="plan" class="band plan" aria-labelledby="plan-title">
    <header class="band-head">
      <p class="eyebrow">Two floors</p>
      <h2 id="plan-title">Find your room.</h2>
      <p class="lede">Upstairs, the master and twin bedrooms face each other across the games room. The queen bedroom, the living room and the kitchen are on the ground floor. Choose a room to see it.</p>
    </header>
    <FloorPlan />
  </section>

  <section id="particulars" class="band facts" aria-labelledby="facts-title">
    <header class="band-head">
      <p class="eyebrow">Before you book</p>
      <h2 id="facts-title">The particulars.</h2>
    </header>
    <Particulars />
  </section>

  <section class="band tour" aria-labelledby="tour-title">
    <h2 id="tour-title" class="small-h">Walk through the house</h2>
    <VideoFacade videoId={L.videoId} poster={master.src} title={`Video tour of ${L.name}`} />
  </section>

  <section class="band rules" aria-labelledby="rules-title">
    <div>
      <h2 id="rules-title" class="small-h">House rules</h2>
      <p class="muted"><a class="link-draw" href="/house-rules/">Rules, payment and cancellation in full</a></p>
    </div>
    <ul>
      {L.rules.map((r) => (
        <li class="reveal-rise"><span class="r-title">{r.title}</span><span class="muted"><Placeholdered text={r.detail} /></span></li>
      ))}
    </ul>
  </section>

  <section class="band nearby" aria-labelledby="nearby-title">
    <h2 id="nearby-title" class="small-h">Getting here</h2>
    <p class="lede">About 25 minutes from Allama Iqbal International Airport by car, and 15 from Dolmen Mall and DHA Raya. <a class="link-draw" href="/location/">The drive-time map</a></p>
  </section>
</BaseLayout>

<style>
  .open { display: grid; gap: var(--space-6); max-width: var(--container-wide); margin: 0 auto; padding: var(--space-6) var(--gutter) var(--space-8); }
  .open-copy > * + * { margin-top: var(--space-4); }
  .open h1 { font-size: clamp(56px, 11vw, 140px); line-height: 0.92; letter-spacing: -0.025em; }
  .price { font-size: 15px; color: var(--color-muted); }
  .price span { font-family: var(--font-display); font-size: 32px; color: var(--color-charcoal); }
  .open-photos { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .open-photos :global(.ph-main-pic) { grid-column: 1 / 3; display: block; }
  .open-photos :global(.ph-main) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .open-photos :global(.ph-side) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }
  .all { align-self: end; justify-self: start; display: inline-flex; gap: var(--space-2); align-items: center; color: var(--color-charcoal); font-weight: 500; min-height: 44px; }
  @media (min-width: 768px) {
    .open { grid-template-columns: 5fr 6fr; align-items: end; padding-top: var(--space-7); }
    .open-photos { grid-template-columns: 3fr 2fr; align-items: end; }
    .open-photos :global(.ph-main-pic) { grid-column: 1; grid-row: 1 / 3; }
    .open-photos :global(.ph-side) { grid-column: 2; grid-row: 1; margin-bottom: var(--space-8); }
    .all { grid-column: 2; grid-row: 2; }
  }

  .band { max-width: var(--container-wide); margin: 0 auto; padding: var(--space-9) var(--gutter); }
  .band-head { max-width: 760px; margin-bottom: var(--space-7); }
  .band-head > * + * { margin-top: var(--space-3); }
  .band h2 { font-size: clamp(44px, 8vw, 104px); line-height: 0.98; letter-spacing: -0.02em; }
  .band .small-h { font-size: var(--type-h2-size); line-height: var(--type-h2-line); letter-spacing: var(--type-h2-tracking); margin-bottom: var(--space-5); }
  .lede a { color: var(--color-charcoal); font-weight: 500; }
  .plan { border-top: 1px solid var(--color-charcoal); }
  .facts { background: var(--color-stone-50); max-width: none; }
  .facts > * { max-width: var(--container-default); margin-left: auto; margin-right: auto; }
  .tour { max-width: var(--container-default); }
  .rules { display: grid; gap: var(--space-5); border-top: 1px solid var(--color-charcoal); }
  @media (min-width: 1024px) { .rules { grid-template-columns: 4fr 7fr; } }
  .rules ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 var(--space-6); }
  .rules li { display: flex; flex-direction: column; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-line); }
  .r-title { font-weight: 500; }
  .rules a, .nearby a { color: var(--color-charcoal); font-weight: 500; }
  .nearby { padding-top: 0; }
</style>
