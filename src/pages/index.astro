---
// Home (redesign: concept B spine). Story first (a day at the house), then the rooms, then the facts,
// then where it is. One booking entry point: the sticky bar from BaseLayout.
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DayStory from '../components/home/DayStory.astro';
import RoomIndex from '../components/RoomIndex.astro';
import Particulars from '../components/Particulars.astro';
import { DHA_RETREAT as L } from '../content/listings';
import { whatsappLink } from '../content/site';
import { organizationLd, websiteLd } from '../lib/seo';
import logoStacked from '../assets/brand/logo-stacked-charcoal.png';

const logo = await getImage({ src: logoStacked, width: 600, format: 'png' });
const jsonLd = [websiteLd(Astro.site!), organizationLd(Astro.site!, new URL(logo.src, Astro.site).href)];
const nearby = L.nearby.filter((n) => ['Allama Iqbal International Airport', 'Dolmen Mall', 'DHA 9 Town Park'].includes(n.place));
---
<BaseLayout
  title="Three-bedroom house to rent in DHA Phase 9, Lahore | SAHA Residences"
  description="Book DHA Retreat directly: a two-storey, three-bedroom house in DHA Phase 9 Town, Lahore, with solar backup, a games room, a caretaker on site and room for up to 8 guests. From USD 60 a night."
  jsonLd={jsonLd}
>
  <DayStory />

  <section class="rooms band" aria-labelledby="rooms-title">
    <header class="band-head">
      <p class="eyebrow">Two floors</p>
      <h2 id="rooms-title">The rooms.</h2>
      <p class="lede">Bedrooms on both floors, a games room between the two upstairs, and the living room and kitchen downstairs. <a class="link-draw" href={`/stays/${L.slug}/#plan`}>See the floor plan</a></p>
    </header>
    <RoomIndex />
  </section>

  <section class="facts band" aria-labelledby="facts-title">
    <header class="band-head narrow">
      <p class="eyebrow">Before you book</p>
      <h2 id="facts-title">The particulars.</h2>
    </header>
    <Particulars />
  </section>

  <section class="quote band" aria-label="What guests say">
    <blockquote>
      <p><mark class="placeholder">[PLACEHOLDER: one real guest review, quoted word for word]</mark></p>
      <footer><mark class="placeholder">[PLACEHOLDER: first name and initial, month, source (e.g. Airbnb), linked to the public listing]</mark></footer>
    </blockquote>
  </section>

  <section class="where band" aria-labelledby="where-title">
    <div class="where-copy">
      <p class="eyebrow">DHA Phase 9 Town, Lahore</p>
      <h2 id="where-title">Twenty-five minutes from the airport.</h2>
      <a class="link-draw more" href="/location/">Drive times and the area</a>
    </div>
    <ul class="times">
      {nearby.map((n) => <li class="reveal-rise"><span class="mins">{n.time}</span><span>{n.place}</span></li>)}
    </ul>
  </section>

  <section class="close band" aria-label="Contact">
    <p>Questions first? <a class="link-draw" href={whatsappLink('Hello, I have a question about DHA Retreat.')} data-event="whatsapp_click">Message us on WhatsApp</a>. A real person in Lahore will reply.</p>
  </section>
</BaseLayout>

<style>
  .band { padding: var(--space-9) var(--gutter); max-width: var(--container-wide); margin: 0 auto; }
  .band-head { max-width: 760px; margin-bottom: var(--space-7); }
  .band-head > * + * { margin-top: var(--space-3); }
  .band h2 { font-size: clamp(44px, 8vw, 104px); line-height: 0.98; letter-spacing: -0.02em; }
  .lede { max-width: 52ch; }
  .lede a { color: var(--color-charcoal); font-weight: 500; }

  /* Facts sit on stone-50 and indent: a change of rhythm after the full-width rooms. */
  .facts { background: var(--color-stone-50); max-width: none; }
  .facts > * { max-width: var(--container-default); margin-left: auto; margin-right: auto; }
  @media (min-width: 1024px) { .facts .band-head { padding-left: 8%; } }

  .quote { text-align: left; }
  .quote blockquote { margin: 0 0 0 auto; max-width: 820px; font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 42px); line-height: 1.3; }
  .quote footer { font-family: var(--font-sans); font-size: 14px; color: var(--color-muted); margin-top: var(--space-4); }

  .where { display: grid; gap: var(--space-6); border-top: 1px solid var(--color-charcoal); }
  @media (min-width: 1024px) { .where { grid-template-columns: 7fr 5fr; align-items: end; } }
  .where h2 { max-width: 12ch; }
  .more { display: inline-block; margin-top: var(--space-5); color: var(--color-charcoal); font-weight: 500; }
  .times { list-style: none; margin: 0; padding: 0; }
  .times li { display: grid; grid-template-columns: 7rem 1fr; align-items: baseline; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
  .mins { font-family: var(--font-display); font-size: 32px; line-height: 1; color: var(--color-walnut); }

  .close { padding-top: 0; }
  .close p { font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line); max-width: 60ch; }
  .close a { color: var(--color-charcoal); font-weight: 500; }
</style>
