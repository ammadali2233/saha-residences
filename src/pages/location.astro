---
// Location (redesign: concept C's drive-time map). Area only: the exact pin is shared after confirmation.
import BaseLayout from '../layouts/BaseLayout.astro';
import DriveTimeMap from '../components/DriveTimeMap.astro';
import { DHA_RETREAT as L } from '../content/listings';
import { whatsappLink } from '../content/site';
import { breadcrumbLd } from '../lib/seo';
---
<BaseLayout
  title="Location: DHA Phase 9 Town, Lahore, near the airport"
  description="DHA Retreat is in DHA Phase 9 Town, Lahore: about 25 minutes from Allama Iqbal International Airport and 15 minutes from Dolmen Mall and DHA Raya. A drive-time map of the area."
  jsonLd={[breadcrumbLd([{ name: 'Location', url: new URL(Astro.url.pathname, Astro.site) }])]}
>
  <section class="open" aria-labelledby="loc-title">
    <p class="eyebrow">DHA Phase 9 Town, Lahore</p>
    <h1 id="loc-title">Twenty-five minutes from the airport.</h1>
    <p class="lede">{L.name} sits in a residential part of DHA Lahore, with Dolmen Mall and DHA Raya about fifteen minutes away and Gulberg about thirty.</p>
  </section>

  <section class="band map" aria-label="Drive times from the house">
    <DriveTimeMap />
  </section>

  <section class="band notes" aria-labelledby="notes-title">
    <h2 id="notes-title" class="visually-hidden">Getting here and the area</h2>
    <div class="note">
      <h3>Getting here</h3>
      <p>Most guests come by car or ride-hailing from Allama Iqbal International Airport. <mark class="placeholder">[PLACEHOLDER: airport pickup available? price?]</mark></p>
    </div>
    <div class="note">
      <h3>The area</h3>
      <p><mark class="placeholder">[PLACEHOLDER: two or three sentences on the neighbourhood in the owner's words: what's walkable, nearby grocery shops, mosques, parks]</mark></p>
    </div>
    <div class="note">
      <h3>Directions</h3>
      <p>Once your booking is confirmed we send the exact location on WhatsApp. <a class="link-draw" href={whatsappLink('Hello, could you help with directions to DHA Retreat?')} data-event="whatsapp_click">Ask us on WhatsApp</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .open { max-width: var(--container-wide); margin: 0 auto; padding: var(--space-7) var(--gutter) var(--space-6); }
  .open > * + * { margin-top: var(--space-4); }
  .open h1 { font-size: clamp(48px, 9vw, 120px); line-height: 0.95; letter-spacing: -0.02em; max-width: 12ch; }
  .band { max-width: var(--container-wide); margin: 0 auto; padding: var(--space-7) var(--gutter); }
  .map { background: var(--color-stone-50); max-width: none; }
  .map > :global(*) { max-width: var(--container-wide); margin: 0 auto; }
  .notes { display: grid; gap: var(--space-6); }
  @media (min-width: 768px) { .notes { grid-template-columns: repeat(3, 1fr); } }
  .note h3 { font-family: var(--font-sans); font-size: var(--type-h6-size); letter-spacing: var(--type-h6-tracking); text-transform: uppercase; font-weight: 500; color: var(--color-walnut); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-charcoal); margin-bottom: var(--space-3); }
  .note a { color: var(--color-charcoal); font-weight: 500; }
</style>
