---
// Concept A, "The house, drawn": architectural line drawing as the visual language. The arch from the
// SAHA mark frames the photography; floor-plan lines draw in as you scroll and the plan is the navigation.
import { Picture } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import FloorPlan from '../../components/concepts/FloorPlan.astro';
import { DHA_RETREAT as L } from '../../content/listings';
const hero = L.photos[0];
---
<ConceptLayout letter="a" name="The house, drawn">
  <section class="hero" aria-labelledby="a-title">
    <div class="copy">
      <p class="tag">Plan 01 · DHA Phase 9 Town, Lahore</p>
      <h1 id="a-title">A two-storey house for slow days in Lahore.</h1>
      <p class="sub">Three bedrooms, a games room upstairs and solar power that keeps the lights on. Booked directly with the people who look after it.</p>
      <a class="link-draw scroll-cue" href="#plan">See the plan</a>
    </div>
    <div class="frame">
      <svg class="arch-lines" viewBox="0 0 400 520" aria-hidden="true" preserveAspectRatio="none">
        <path class="draw-line t1" pathLength="1" d="M12 520 V200 A188 188 0 0 1 388 200 V520" />
        <path class="draw-line t2" pathLength="1" d="M0 506 H400" />
        <path class="draw-line t3" pathLength="1" d="M-30 20 H60 M-30 14 V26 M60 14 V26" />
      </svg>
      <Picture
        class="arch-photo"
        src={hero.src}
        alt={hero.alt}
        formats={['avif', 'webp']}
        widths={[400, 600, 800, 1086]}
        sizes="(max-width: 767px) 88vw, 40vw"
        loading="eager"
        fetchpriority="high"
      />
      <p class="dim" aria-hidden="true">Master bedroom · upstairs</p>
    </div>
  </section>

  <section id="plan" class="plan-section" aria-labelledby="plan-title">
    <header class="plan-head">
      <p class="tag reveal-rise">Plan 02 · Two floors</p>
      <h2 id="plan-title" class="reveal-rise">Find your room.</h2>
      <p class="sub reveal-rise">Upstairs, the master and twin bedrooms face each other across the games room. The queen bedroom, living room and kitchen are on the ground floor. Tap a room to see it.</p>
    </header>
    <FloorPlan />
  </section>
</ConceptLayout>

<style>
  .tag { font-size: var(--type-label-size); line-height: var(--type-label-line); letter-spacing: var(--type-label-tracking); text-transform: uppercase; font-weight: 500; color: var(--color-muted); }
  .sub { font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line); color: var(--color-muted); max-width: 46ch; }

  .hero { display: grid; gap: var(--space-7); padding: var(--space-7) var(--gutter) var(--space-8); max-width: var(--container-wide); margin: 0 auto; align-items: center; }
  .copy > * + * { margin-top: var(--space-4); }
  .hero h1 { font-size: clamp(44px, 9vw, 104px); line-height: 0.98; letter-spacing: -0.02em; max-width: 11ch; }
  .scroll-cue { display: inline-block; color: var(--color-charcoal); font-weight: 500; margin-top: var(--space-6); }
  .frame { position: relative; width: min(100%, 460px); justify-self: center; aspect-ratio: 400 / 520; }
  .frame :global(.arch-photo) { position: absolute; inset: 24px 24px 14px; width: calc(100% - 48px); height: calc(100% - 38px); object-fit: cover; border-radius: 999px 999px 0 0; }
  .arch-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .arch-lines .draw-line { fill: none; stroke: var(--color-charcoal); stroke-width: 1.25; vector-effect: non-scaling-stroke; }
  .dim { display: none; position: absolute; left: -8px; top: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); writing-mode: vertical-rl; transform: rotate(180deg) translateX(100%); }
  @media (min-width: 768px) {
    .hero { grid-template-columns: 7fr 5fr; padding-top: var(--space-8); }
    .dim { display: block; }
    .hero h1 { margin-right: -12%; position: relative; z-index: 1; } /* type overlaps into the drawing */
  }
  /* The drawing lines in once on load; the photo and headline are never hidden (LCP). */
  @media (prefers-reduced-motion: no-preference) {
    .arch-lines .draw-line { animation: motion-draw var(--motion-draw) var(--ease-settle) both; }
    .arch-lines .t2 { animation-delay: 300ms; }
    .arch-lines .t3 { animation-delay: 600ms; }
  }

  .plan-section { max-width: var(--container-wide); margin: 0 auto; padding: var(--space-8) var(--gutter); border-top: 1px solid var(--color-charcoal); }
  .plan-head { max-width: 760px; margin-bottom: var(--space-7); }
  .plan-head > * + * { margin-top: var(--space-3); }
  .plan-head h2 { font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: -0.01em; }
</style>
