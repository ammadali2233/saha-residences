---
// Concept C, "Field journal": a travel journal kept by the hosts. Photos placed like prints, sparing pen
// annotations, numbered entries, and a drive-time map whose routes draw themselves as you scroll.
import { Image, Picture } from 'astro:assets';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { DHA_RETREAT as L } from '../../content/listings';
import { SITE } from '../../content/site';
const [master, , second] = L.photos;

// Drive-time map: radius = minutes by car (from the owner's flyer, to confirm). Directions are schematic.
const R = (min: number) => 40 + min * 7.2;
const places = [
  { name: 'DHA 9 Town Park', min: 4, deg: 60 },
  { name: 'DHA Raya', min: 15, deg: -40 },
  { name: 'Dolmen Mall', min: 15, deg: 25 },
  { name: '2F2F Karting', min: 20, deg: 160 },
  { name: 'Airport', min: 25, deg: -95 },
  { name: 'Neon Square', min: 25, deg: 95 },
  { name: 'Gulberg', min: 30, deg: -160 },
].map((p, i) => {
  const r = R(p.min);
  const a = (p.deg * Math.PI) / 180;
  const x = 300 + r * Math.cos(a);
  const y = 300 + r * Math.sin(a);
  // A gently bowed route, like a pen line, from the house to the place.
  const bend = (i % 2 ? 1 : -1) * r * 0.18;
  const cx = 300 + (r / 2) * Math.cos(a) - bend * Math.sin(a);
  const cy = 300 + (r / 2) * Math.sin(a) + bend * Math.cos(a);
  const right = Math.cos(a) >= 0;
  return { ...p, x, y, lx: x + (right ? 12 : -12), anchor: right ? "start" : "end", d: `M300 300 Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`, i };
});
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('DHA Phase 9 Town, Lahore')}`;
---
<ConceptLayout letter="c" name="Field journal">
  <section class="hero" aria-labelledby="c-title">
    <div class="copy">
      <p class="entry">Entry 01 · {SITE.area}, {SITE.city}</p>
      <h1 id="c-title">Notes from a house we look after in Lahore.</h1>
      <p class="sub">
        Three bedrooms over two floors, power that stays on, and a caretaker on site.
        Room for <span class="circled">eight<svg viewBox="0 0 120 50" preserveAspectRatio="none" aria-hidden="true"><path class="pen draw-line" pathLength="1" d="M8 30 C 10 8, 104 4, 112 22 C 118 40, 30 48, 10 36 C 4 32, 12 20, 30 14" /></svg></span>, if two don't mind extra bedding.
      </p>
    </div>
    <div class="prints">
      <figure class="print p1">
        <Picture src={master.src} alt={master.alt} formats={['avif', 'webp']} widths={[400, 600, 800, 1086]} sizes="(max-width: 767px) 80vw, 34vw" loading="eager" fetchpriority="high" />
        <figcaption>Master bedroom, upstairs.</figcaption>
      </figure>
      <figure class="print p2">
        <Image src={second.src} alt={second.alt} widths={[300, 500]} sizes="(max-width: 767px) 50vw, 20vw" loading="eager" />
        <figcaption>Queen room, ground floor.</figcaption>
      </figure>
      <p class="note n1" aria-hidden="true">
        <svg viewBox="0 0 140 80" aria-hidden="true"><path class="pen draw-line" pathLength="1" d="M136 6 C 100 10, 60 30, 30 60 M30 60 l 12 -2 M30 60 l 2 -12" /></svg>
        <span>A velvet bench at the foot of the king bed.</span>
      </p>
    </div>
  </section>

  <section class="map-section" aria-labelledby="map-title">
    <header class="map-head">
      <p class="entry reveal-rise">Entry 02 · Getting around</p>
      <h2 id="map-title" class="reveal-rise">Twenty-five minutes from the airport.</h2>
      <p class="sub reveal-rise">Drive times from the house, outside rush hour. The rings are minutes by car; directions are only a sketch. <mark class="placeholder">[PLACEHOLDER: confirm times; real map directions in the full build]</mark></p>
    </header>
    <div class="map-wrap">
      <svg class="time-map draw-on-scroll" viewBox="0 0 600 600" role="img" aria-labelledby="map-title map-desc">
        <desc id="map-desc">Sketch map of drive times from DHA Retreat. The list beside it gives each place and time.</desc>
        {[10, 20, 30].map((m) => (
          <>
            <circle class="ring" cx="300" cy="300" r={R(m)} />
            <text class="ring-lbl" x={300 + R(m) + 4} y="296">{m} min</text>
          </>
        ))}
        {places.map((p) => (
          <g class="route" style={`--i:${p.i}`}>
            <path class="pen draw-line" pathLength="1" d={p.d} />
            <circle class="pin" cx={p.x} cy={p.y} r="5" />
            <text class="place" x={p.lx} y={p.y - 2} text-anchor={p.anchor}>{p.name}</text>
            <text class="mins" x={p.lx} y={p.y + 18} text-anchor={p.anchor}>{p.min} min</text>
          </g>
        ))}
        <g class="home">
          <circle cx="300" cy="300" r="16" />
          <text x="300" y="340">DHA Retreat</text>
        </g>
      </svg>
      <div class="legend">
        <ul class="times">
          {[...places].sort((a, b) => a.min - b.min).map((p) => <li><span>{p.name}</span><span>{p.min} min</span></li>)}
        </ul>
        <a class="link-draw maps" href={mapsLink} rel="noopener">Open the area in Google Maps</a>
        <p class="fine">We send the exact address and pin once your booking is confirmed.</p>
      </div>
    </div>
  </section>
</ConceptLayout>

<style>
  .entry { font-size: var(--type-label-size); letter-spacing: var(--type-label-tracking); text-transform: uppercase; font-weight: 500; color: var(--color-walnut); }
  .sub { font-size: var(--type-body-lg-size); line-height: 1.75; color: var(--color-muted); max-width: 44ch; }
  .pen { fill: none; stroke: var(--color-walnut); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }

  .hero { max-width: var(--container-wide); margin: 0 auto; padding: var(--space-7) var(--gutter) var(--space-8); display: grid; gap: var(--space-7); }
  .copy > * + * { margin-top: var(--space-4); }
  .hero h1 { font-size: clamp(42px, 8.5vw, 100px); line-height: 1; letter-spacing: -0.02em; max-width: 13ch; }
  .circled { position: relative; white-space: nowrap; color: var(--color-charcoal); }
  .circled svg { position: absolute; inset: -10px -14px -8px -12px; width: calc(100% + 26px); height: calc(100% + 18px); overflow: visible; }

  .prints { position: relative; min-height: 420px; }
  .print { margin: 0; background: var(--color-stone-50); padding: 10px 10px 0; box-shadow: var(--elevation-2); position: absolute; }
  .print :global(img) { display: block; width: 100%; height: auto; }
  .print figcaption { font-size: 13px; color: var(--color-muted); padding: var(--space-2) 2px var(--space-3); }
  .p1 { width: 66%; left: 0; top: 0; transform: rotate(-1.5deg); }
  .p1 :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  .p2 { width: 44%; right: 0; top: 46%; transform: rotate(2deg); }
  .p2 :global(img) { aspect-ratio: 1; object-fit: cover; }
  .note { position: absolute; right: 0; top: 4%; width: 28%; font-size: 14px; line-height: 1.4; color: var(--color-walnut); }
  .note svg { width: 100%; max-width: 140px; height: auto; display: block; }
  @media (max-width: 767px) { .prints { min-height: 0; aspect-ratio: 1 / 1.25; } }
  @media (min-width: 768px) {
    .hero { grid-template-columns: 5fr 6fr; align-items: center; padding-top: var(--space-8); }
    .prints { min-height: 640px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero .pen { animation: motion-draw var(--motion-draw) var(--ease-settle) 400ms both; }
    .print { transition: transform var(--motion-state) var(--ease-settle); }
    .p1:hover { transform: rotate(-0.5deg) translateY(-4px); }
    .p2:hover { transform: rotate(1deg) translateY(-4px); }
  }

  .map-section { background: var(--color-stone-50); padding: var(--space-8) var(--gutter); }
  .map-head { max-width: var(--container-wide); margin: 0 auto var(--space-6); }
  .map-head > * + * { margin-top: var(--space-3); }
  .map-head h2 { font-size: clamp(36px, 6vw, 72px); line-height: 1.02; max-width: 14ch; }
  .map-wrap { max-width: var(--container-wide); margin: 0 auto; display: grid; gap: var(--space-6); }
  @media (min-width: 1024px) { .map-wrap { grid-template-columns: 7fr 4fr; align-items: center; } }
  .time-map { width: 100%; height: auto; max-width: 680px; overflow: visible; }
  .ring { fill: none; stroke: var(--color-line-strong); stroke-width: 1; stroke-dasharray: 2 6; vector-effect: non-scaling-stroke; }
  .ring-lbl { font-family: var(--font-sans); font-size: 12px; fill: var(--color-muted); }
  .pin { fill: var(--color-charcoal); }
  .place { font-family: var(--font-display); font-size: 20px; fill: var(--color-charcoal); }
  .mins { font-family: var(--font-sans); font-size: 14px; fill: var(--color-walnut); font-weight: 500; }
  .home circle { fill: var(--color-walnut); }
  .home text { font-family: var(--font-sans); font-size: 14px; font-weight: 500; text-anchor: middle; fill: var(--color-charcoal); }
  .times { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-charcoal); }
  .times li { display: flex; justify-content: space-between; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
  .times li span:last-child { color: var(--color-walnut); font-weight: 500; }
  .maps { display: inline-block; margin-top: var(--space-5); color: var(--color-charcoal); font-weight: 500; }
  .fine { font-size: 13px; color: var(--color-muted); margin-top: var(--space-2); }
  @media (max-width: 767px) { .place { font-size: 26px; } .mins, .home text { font-size: 20px; } .ring-lbl { font-size: 18px; } }

  /* Routes draw out one after another; the time appears as each line arrives. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .route .draw-line { animation-range: entry calc(10% + var(--i) * 4%) cover calc(30% + var(--i) * 4%) !important; }
      .route .mins, .route .pin { animation: motion-fade linear both; animation-timeline: view(); animation-range: cover calc(28% + var(--i) * 4%) cover calc(34% + var(--i) * 4%); }
    }
  }
</style>
