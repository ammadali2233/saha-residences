{
  "name": "saha-residences",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && astro dev",
    "check": "astro check",
    "build": "npm run tokens && astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "test:e2e": "playwright test",
    "test:auth": "node --env-file=.dev.vars tests/e2e/admin-auth.mjs",
    "admin:create": "node --env-file=.dev.vars scripts/create-admin.mjs",
    "backup:drill": "node scripts/restore-drill.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/preact": "6.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.4.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
